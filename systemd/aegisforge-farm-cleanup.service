[Unit]
Description=Conservative cleanup of AegisForge-generated cache and stale temporary files
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/agent-farm
ExecStart=/bin/bash /opt/agent-farm/scripts/farm_cleanup.sh --apply
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/agent-farm /run/lock
