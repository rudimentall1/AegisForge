{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rudimentall1/AegisForge/blob/main/tools/evm_key_forensics/source-provenance.schema.json",
  "title": "EVM Key Forensics Source Provenance Record",
  "description": "Records provenance claims and their verification state. This schema validates shape only; it does not authenticate publishers, verify claims, or establish independent evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "content_integrity",
    "publisher_identity",
    "origin_relationship",
    "independence_assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "evm-source-provenance-v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "content_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "MATCHED",
            "MISMATCHED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "observed_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "publisher_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_name",
        "verification_status"
      ],
      "properties": {
        "claimed_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "CONTRADICTED",
            "UNKNOWN"
          ]
        },
        "verification_method": {
          "enum": [
            "NONE",
            "DOMAIN_CONTROL",
            "PUBLISHER_SIGNING_KEY",
            "TRUSTED_REGISTRY",
            "MANUAL_REVIEW",
            "OTHER"
          ]
        },
        "verification_evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference to a separately stored verification record; a URL or self-assertion alone is not proof."
        },
        "verified_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identity of the verifier, not the source publisher."
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "origin_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derived_from_source_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "PRIMARY_ORIGIN_VERIFIED",
            "DERIVED_FROM_KNOWN_SOURCE",
            "UNKNOWN",
            "CONTRADICTED"
          ]
        },
        "canonical_origin_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "derived_from_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference to evidence supporting origin or derivation; this record does not itself validate that evidence."
        }
      }
    },
    "independence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "ESTABLISHED",
            "NOT_ESTABLISHED",
            "DEPENDENT",
            "CONTRADICTED",
            "UNKNOWN"
          ]
        },
        "basis": {
          "enum": [
            "VERIFIED_DISTINCT_ORIGINS",
            "SHARED_ORIGIN",
            "DECLARED_DERIVATION",
            "CONTENT_HASH_ONLY",
            "URL_ONLY",
            "NO_VERIFIED_PROVENANCE",
            "CONFLICTING_PROVENANCE",
            "OTHER"
          ]
        },
        "review_record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publisher_identity": {
            "properties": {
              "verification_status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "verification_status"
            ]
          }
        },
        "required": [
          "publisher_identity"
        ]
      },
      "then": {
        "properties": {
          "publisher_identity": {
            "required": [
              "verification_method",
              "verification_evidence_ref",
              "verified_by",
              "verified_at"
            ],
            "properties": {
              "verification_method": {
                "enum": [
                  "DOMAIN_CONTROL",
                  "PUBLISHER_SIGNING_KEY",
                  "TRUSTED_REGISTRY",
                  "MANUAL_REVIEW",
                  "OTHER"
                ]
              },
              "verification_evidence_ref": {
                "type": "string",
                "minLength": 1
              },
              "verified_by": {
                "type": "string",
                "minLength": 1
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin_relationship": {
            "properties": {
              "status": {
                "const": "PRIMARY_ORIGIN_VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "origin_relationship"
        ]
      },
      "then": {
        "properties": {
          "origin_relationship": {
            "required": [
              "canonical_origin_ref",
              "verification_evidence_ref"
            ],
            "properties": {
              "canonical_origin_ref": {
                "type": "string",
                "minLength": 1
              },
              "verification_evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "independence_assessment": {
            "properties": {
              "status": {
                "const": "ESTABLISHED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "independence_assessment"
        ]
      },
      "then": {
        "properties": {
          "independence_assessment": {
            "required": [
              "review_record_ref",
              "reviewed_by",
              "reviewed_at"
            ],
            "properties": {
              "basis": {
                "const": "VERIFIED_DISTINCT_ORIGINS"
              },
              "review_record_ref": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_by": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ]
}
