# Supply immutable image references ending in @sha256:<64 hex characters>.
AEGISFORGE_PYTHON_IMAGE=python:3.12-slim@sha256:REPLACE_WITH_VERIFIED_DIGEST
AEGISFORGE_FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Exact provider URL and exact DNS host(s), comma-separated. No wildcards.
AEGISFORGE_RPC_GATEWAY_UPSTREAM_URL=https://rpc-provider.example/v1/YOUR_PROJECT_ID
AEGISFORGE_RPC_GATEWAY_ALLOWED_HOSTS=rpc-provider.example

# Generate a unique random ASCII token of at least 32 characters.
AEGISFORGE_RPC_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Required exact historical block; never leave this as a moving latest tag.
AEGISFORGE_ANVIL_FORK_BLOCK_NUMBER=REPLACE_WITH_BLOCK_NUMBER
AEGISFORGE_ANVIL_CHAIN_ID=31337
