[Unit]
Description=AegisForge isolated Ed25519 attestation signer
After=network.target

[Service]
Type=simple
User=aegisforge-signer
Group=aegisforge-signer
WorkingDirectory=/opt/agent-farm
EnvironmentFile=/etc/aegisforge/signer.env
ExecStart=/opt/agent-farm/.venv/bin/python -m shared.attestation_signer
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
